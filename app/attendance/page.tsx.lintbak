'use client';

// =============================================================================
// app/attendance/page.tsx
// -----------------------------------------------------------------------------
// Three children, in the order a student actually uses them:
//   1. WeekStrip — "have I logged everything?"   read-only
//   2. MarkList  — the ten-second daily habit    the only marking surface
//   3. RingGrid  — "am I safe?"                  resting view, no numbers
//
// ★ NO "OTHER SUBJECTS" DROPDOWN. Spec §4.4: every subject in THIS YEAR'S
//   schedule appears on the main page. Burying half of them behind a disclosure
//   triangle recreated the exact failure the ring grid exists to prevent — a
//   subject sliding toward debarment while the screen looks calm.
//
// ⚠ selectedDate LIVES HERE. The strip and the list must always agree on which
//   day is in focus. If either owned that state the other would need telling,
//   and they would drift the first time a third entry point appeared (the list
//   already has a calendar jump). One owner, two consumers, no sync code.
//
// ═════════════════════════════════════════════════════════════════════════════
//  ⚠ WHY useSyncExternalStore AND NOT useEffect + useState
// ═════════════════════════════════════════════════════════════════════════════
// This page used to do the classic thing:
//
//     const [mounted, setMounted] = useState(false);
//     useEffect(() => { setMounted(true); }, []);
//
// React 19's react-hooks/set-state-in-effect rule rejects that, and it is right
// to. Calling setState in an effect body forces a SECOND render immediately
// after the first — the component paints, React notices state changed, and
// paints again. On a mid-range phone that is a visible flicker on every open.
//
// localStorage is an EXTERNAL STORE. useSyncExternalStore is the hook built for
// external stores, and it solves both problems this page has:
//
//   1. HYDRATION. It takes a separate server snapshot. The server and the first
//      client render both read `false` and produce the identical skeleton, so
//      there is no mismatch. The client snapshot (`true`) is adopted straight
//      after hydration, in the same commit — not in a follow-up render.
//
//   2. REPAINTING ON WRITES. Our store's subscribe() is exactly the shape this
//      hook wants. The counter lives at MODULE level, not in component state,
//      because getSnapshot must return a value that is stable between
//      notifications — return a fresh object or a fresh number each call and
//      React loops forever.
// ═════════════════════════════════════════════════════════════════════════════
//
// ★ MIGRATIONS RUN BEFORE THE FIRST STORE READ. runMigrations() converts
//   v2 → v3 → v4 and was called by nothing for several build steps, meaning
//   anyone upgrading silently landed on defaults: 75% everywhere, extras
//   reverting to the old global policy, custom targets gone.
//
//   It is now a plain module-level function with its own guard, called during
//   render from the client-only subtree — NOT from an effect. Three things this
//   buys us:
//     1. It cannot possibly run after a store read, because it runs on the line
//        above the first one.
//     2. It cannot double-run. The module guard outlives StrictMode's double
//        invoke, outlives remounts, and outlives fast refresh.
//     3. Its result is a plain value, so it needs no state and triggers no
//        extra render.
//
//   ⚠ STILL OUTSTANDING (SM-1): a student whose first stop is /settings reads
//     pre-migration data. Proper home is a root-layout effect. Do it when the
//     settings shell is built, alongside the layout.tsx font issue.
// =============================================================================

import { useCallback, useMemo, useState, useSyncExternalStore } from 'react';
import Link from 'next/link';

import WeekStrip from './components/WeekStrip';
import MarkList from './components/MarkList';
import RingGrid from './components/RingGrid';

import { getSettings, runMigrations, subscribe } from './store';
import { getYearResult, getUnmarkedCount } from './calculate';
import { todayISO } from '@/lib/attendance/datetime';
import type { ISODate } from './types';


// =============================================================================
// Module-level plumbing
//
// Everything here is deliberately OUTSIDE the component. Module scope survives
// remounts, StrictMode's deliberate double-invoke, and fast refresh — which is
// precisely the lifetime a one-shot migration and a store counter need.
// =============================================================================

/**
 * Bumped once per store write. useSyncExternalStore compares the value it gets
 * from getSnapshot against the previous one; a change means re-render.
 *
 * ⚠ MUST live out here. As component state it would reset on every remount and
 *   the hook would lose track of what it had already seen.
 */
let storeRevision = 0;

/**
 * The subscribe function handed to useSyncExternalStore.
 *
 * ⚠ MUST be a stable reference — defining it inside the component would give
 *   React a brand-new function every render, and it would dutifully unsubscribe
 *   and resubscribe every single time.
 */
function subscribeToStore(onStoreChange: () => void): () => void {
  return subscribe(() => {
    storeRevision += 1;
    onStoreChange();
  });
}

const getStoreRevision = (): number => storeRevision;

/** The server has no store, so it is forever at revision zero. */
const getServerRevision = (): number => 0;

/**
 * The mount gate, expressed as an external store that never changes.
 *
 * A subscribe function that does nothing is correct here, not lazy: this
 * "store" has exactly two states — rendering on the server and rendering on the
 * client — and it can never transition again once mounted. Nothing to notify.
 */
const subscribeToNothing = (): (() => void) => () => {};
const getIsClient = (): boolean => true;
const getIsServer = (): boolean => false;

/**
 * Migration, run at most once per page load.
 *
 * `null` means "not attempted yet". After the first call it holds the notes
 * array — usually empty, because a fresh install has nothing to convert.
 */
let migrationNotes: string[] | null = null;

function ensureMigrationsHaveRun(): string[] {
  if (migrationNotes !== null) return migrationNotes;

  // Belt and braces. This should only ever be reached from the client subtree,
  // but if a future refactor calls it during SSR we must not touch storage.
  if (typeof window === 'undefined') return [];

  try {
    const { v3, v4 } = runMigrations();
    migrationNotes = [...v3.notes, ...v4.notes];
  } catch {
    // A failed migration must never white-screen the app. Old data is READ,
    // never deleted, so a failure leaves the student on defaults with their
    // data still recoverable — bad, but survivable.
    migrationNotes = [];
  }

  return migrationNotes;
}


// =============================================================================
// Page
// =============================================================================

export default function AttendancePage() {
  // False on the server AND on the first client render — that equality IS the
  // hydration fix. Flips to true on adoption, with no extra render pass.
  const isMounted = useSyncExternalStore(subscribeToNothing, getIsClient, getIsServer);

  if (!isMounted) return <Skeleton />;

  return <AttendanceContent />;
}


/**
 * Rendered by the server and by the first client pass.
 *
 * ⚠ MUST CONTAIN NO STORE READS. One localStorage value here and the mismatch
 *   simply moves rather than disappearing.
 */
function Skeleton() {
  return (
    <main className="mx-auto max-w-3xl px-4 pb-28 pt-4">
      <div className="h-6 w-40 animate-pulse rounded bg-surface-sunk" />
      <div className="mt-4 h-52 animate-pulse rounded-card bg-surface-sunk" />
      <div className="mt-5 h-7 w-56 animate-pulse rounded bg-surface-sunk" />
      <div className="mt-3 space-y-2">
        <div className="h-24 animate-pulse rounded-card bg-surface-sunk" />
        <div className="h-24 animate-pulse rounded-card bg-surface-sunk" />
      </div>
    </main>
  );
}


/**
 * Client-only. May read the store freely: never renders on the server, never
 * runs before migration.
 */
function AttendanceContent() {
  // ★ LINE ONE, AND IT MUST STAY LINE ONE. Every read below — getSettings,
  //   getYearResult, getUnmarkedCount — depends on the data already having been
  //   converted. Ordering here is not style, it is correctness.
  const notes = ensureMigrationsHaveRun();

  // Repaints on every store write.
  const revision = useSyncExternalStore(
    subscribeToStore,
    getStoreRevision,
    getServerRevision,
  );

  // The migration report is shown until dismissed. Dismissal is a user action,
  // so this setState sits in an event handler where it belongs.
  const [notesDismissed, setNotesDismissed] = useState(false);
  const showNotes = notes.length > 0 && !notesDismissed;

  const today = todayISO();
  const settings = getSettings();
  const year = settings.currentYear;

  // ★ THE ONE PIECE OF STATE THIS PAGE OWNS.
  const [selectedDate, setSelectedDate] = useState<ISODate>(today);

  const jumpToToday = useCallback(() => setSelectedDate(today), [today]);

  /**
   * ONE call. getYearResult is memoised on DataVersion, so after the first
   * render this costs a map lookup. Filtering exam subjects is a filter over
   * the result, never a second computation.
   */
  const { subjects, totalTracked, unmarked } = useMemo(() => {
    void revision; // recompute when the store changes

    const result = getYearResult(year);

    return {
      // Everything in this year's schedule. No dropdown, no second tier.
      subjects: result.subjects.filter((s) => s.isExamSubject),
      totalTracked: result.subjects.length,
      unmarked: getUnmarkedCount(year),
    };
  }, [year, revision]);

  const nothingSetUp = totalTracked === 0;

  return (
    <main className="mx-auto max-w-3xl px-4 pb-28 pt-4">
      {/* ------------------------------------------- migration report ------
          Shown once, only when there is something to report. A silent
          conversion is how trust dies: a student who set 80% and finds 75% next
          week will not think "the migration was imperfect", they will think the
          app is unreliable and go back to paper.

          aria-live="polite": this block appears without any user action, so a
          screen reader would otherwise never mention it. */}
      {showNotes && (
        <div
          role="status"
          aria-live="polite"
          className="mb-4 rounded-field border border-brand-line bg-brand-soft px-4 py-3"
        >
          <div className="flex items-start justify-between gap-3">
            <div className="min-w-0">
              <p className="text-sm font-semibold text-brand-ink">
                Your attendance data was updated
              </p>
              <ul className="mt-1.5 space-y-1">
                {notes.map((note, i) => (
                  <li key={i} className="text-sm text-brand-ink">
                    - {note}
                  </li>
                ))}
              </ul>
            </div>
            <button
              onClick={() => setNotesDismissed(true)}
              aria-label="Dismiss"
              className="modal-close"
            >
              ✕
            </button>
          </div>
        </div>
      )}

      {/* ---------------------------------------------------- header -------
          TWO doors, deliberately distinct:
            Setup    → facts about your college (timetable, hours, postings)
            Settings → your preferences (thresholds, alerts, appearance)
          Keeping them visually equal is the point. If Settings were hidden
          behind Setup, thresholds would stay undiscoverable — which is the
          state they have been in for three sessions. */}
      <header className="mb-3 flex items-baseline justify-between gap-3">
        <div className="min-w-0">
          <h1 className="display truncate text-2xl">Attendance</h1>
          <span className="text-xs text-ink-faint">{year}</span>
        </div>
        <div className="flex shrink-0 items-center gap-1">
          <Link href="/attendance/setup" className="btn btn-ghost min-h-9 text-sm">
            Setup
          </Link>
          <Link href="/settings" className="btn btn-ghost min-h-9 text-sm">
            Settings
          </Link>
        </div>
      </header>

      {/* ------------------------------------------------- week strip ------
          Above the list on purpose: the first question on opening the app is
          "what have I missed?", not "what am I marking?". */}
      <WeekStrip
        anchorDate={selectedDate}
        selectedDate={selectedDate}
        onSelectDay={setSelectedDate}
        revision={revision}
      />

      {/* -------------------------------------------------- mark list ------ */}
      <MarkList
        selectedDate={selectedDate}
        onSelectDate={setSelectedDate}
        revision={revision}
      />

      {/* ------------------------------------------------------ rings ------ */}
      {!nothingSetUp && (
        <section className="mt-9">
          <div className="mb-3 flex items-baseline justify-between gap-2">
            <h2 className="eyebrow">Where you stand</h2>

            {/* A count of OUTSTANDING ACTIONS, never a score. It can be driven
                to zero by doing something, which is the only kind of number
                worth putting in a header. */}
            {unmarked > 0 && (
              <button
                onClick={jumpToToday}
                className="chip chip-watch"
                aria-label={`${unmarked} classes still unmarked. Jump to today.`}
              >
                {unmarked} unmarked
              </button>
            )}
          </div>

          <RingGrid subjects={subjects} revision={revision} />
        </section>
      )}

      {/* ----------------------------------------------- first-run state ---
          Not an error and not an empty box. A student who just installed the
          app needs a door, not a dash. */}
      {nothingSetUp && (
        <section className="card mt-6 p-6 text-center">
          <p className="display text-lg">Nothing tracked yet</p>
          <p className="mt-1.5 text-sm text-ink-muted">
            Add your timetable and we&apos;ll work out where you stand.
          </p>
          <Link href="/attendance/setup" className="btn btn-primary mt-4 inline-flex">
            Set up my timetable
          </Link>
        </section>
      )}
    </main>
  );
}
